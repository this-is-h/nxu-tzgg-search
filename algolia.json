{
    "index_name": "NDTW-TZGG",
    "start_urls": ["https://tuanwei.nxu.edu.cn/"],
    "selectors": {
        "lvl0": ".ar_article_box > h5",
        "lvl1": {
            "selector": "//div[contains(@class, 'v_news_content')]/p[span[contains(@style, '黑体')]]",
            "type": "xpath"
        },
        "lvl2": {
            "selector": "//div[contains(@class, 'v_news_content')]/p[span[contains(@style, '楷体')]]",
            "type": "xpath"
        },
        "text": {
            "selector": "//div[contains(@class, 'v_news_content')]/p[span[contains(@style, '仿宋_gb2312')]] | //div[contains(@class, 'v_news_content')]/p[span[contains(@style, 'fangsong_gb2312')]]",
            "type": "xpath"
        },
        "content": ".v_news_content",
        "date": ".bbt span:first-child"
    },
    "stop_urls": ["https://tuanwei.nxu.edu.cn/system/_content/download.jsp"],
    "selectors_exclude": ["header", "m_header"],
    "custom_settings": {
        "attributesForFaceting": ["date"],
        "attributesToSnippet": ["content:50"],
        "attributesToRetrieve": ["hierarchy", "content", "anchor", "url", "date"],
        "attributesToHighlight": ["hierarchy", "content"],
        "distinct": true,
        "attributeForDistinct": "url",
        "minWordSizefor1Typo": 3,
        "minWordSizefor2Typos": 7,
        "removeWordsIfNoResults": "allOptional"
    }
}
